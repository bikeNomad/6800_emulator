0001                                   opt c,cre,l,s
0002                               
0003                               * IC36 on MCU board: Sound and commas
0004                               * Connector 1J8, upper right of board (pin 1 on top)
0005 0040                          pin1_strobe     equ $40     1J8/1 PB6
0006 0080                          pin2_strobe     equ $80     1J8/2 PB7
0007                               
0008 2100                          pia_data_a      equ $2100
0009 2100                          pia_ddr_a       equ pia_data_a
0010 2101                          pia_ctrl_a      equ pia_data_a+1
0011 2102                          pia_data_b      equ pia_data_a+2
0012 2102                          pia_ddr_b       equ pia_data_b
0013 2103                          pia_ctrl_b      equ pia_data_a+3
0014                               
0015 f000                              org $f000
0016                               
0017                               main
0018 f000 0f                 [ 2 ]     sei                     disable interrupts
0019 f001 8e 00 ff           [ 3 ]     lds     #$ff
0020 f004 bd f0 1e           [ 9 ]     jsr     init_pia
0021 f007 86 40              [ 2 ]     ldaa    #pin1_strobe
0022 f009 5f                 [ 2 ]     clrb
0023                               loop
0024 f00a b7 21 02           [ 5 ]     staa    pia_data_b      drive pin high
0025 f00d b6 21 02           [ 4 ]     ldaa    pia_data_b      read it back
0026 f010 f7 21 02           [ 5 ]     stab    pia_data_b      and drive back low
0027 f013 01                 [ 2 ]     nop
0028 f014 01                 [ 2 ]     nop
0029 f015 01                 [ 2 ]     nop
0030 f016 01                 [ 2 ]     nop
0031 f017 01                 [ 2 ]     nop
0032 f018 01                 [ 2 ]     nop
0033 f019 01                 [ 2 ]     nop
0034 f01a 01                 [ 2 ]     nop
0035 f01b 7e f0 0a           [ 3 ]     jmp     loop
0036                               
0037                               
0038                               init_pia
0039                               * Upon initialization, the PIA control registers are all 0s
0040                               * so the DDRs are selected.
0041 f01e 7f 21 01           [ 6 ]     clr     pia_ctrl_a      select DDRs just in case
0042 f021 7f 21 03           [ 6 ]     clr     pia_ctrl_b
0043 f024 86 ff              [ 2 ]     ldaa    #$FF
0044 f026 b7 21 00           [ 5 ]     staa    pia_ddr_a      set to all outputs
0045 f029 b7 21 02           [ 5 ]     staa    pia_ddr_b      set to all outputs
0046 f02c 86 04              [ 2 ]     ldaa    #$04
0047 f02e b7 21 01           [ 5 ]     staa    pia_ctrl_a      select data regs
0048 f031 b7 21 03           [ 5 ]     staa    pia_ctrl_b      select data regs
0049 f034 4f                 [ 2 ]     clra
0050 f035 b7 21 00           [ 5 ]     staa    pia_data_a      drive all low
0051 f038 b7 21 02           [ 5 ]     staa    pia_data_b      drive all low
0052 f03b 39                 [ 5 ]     rts
0053                               
0054                               nmi_handler
0055 f03c 3b                 [10 ]     rti
0056                               
0057                               swi_handler
0058 f03d 3b                 [10 ]     rti
0059                               
0060                               irq_handler
0061 f03e 3b                 [10 ]     rti
0062                               
0063                               * Vectors
0064 fff8                              org $FFF8
0065 fff8 f0 3e                    irq_entry   fdb irq_handler
0066 fffa f0 3d                    swi_entry   fdb swi_handler
0067 fffc f0 3c                    nmi_entry   fdb nmi_handler
0068 fffe f0 00                    rst_entry   fdb main
