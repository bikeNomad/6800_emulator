; state machine 1
; runs at system clock speed (266MHz, 3.76ns)
; bus cycle: 1.11746046µs
; out base: 0, count: 24
; side base: 25, count: 2 (VMA, R/W), optional
; set base: 25, count: 2
; GPIO 24 is E clock, driven by SM0
; jump pin: none
; For read:
;    txfifo[0] = ~0 << 8
;    txfifo[0] = address << 8
;    read data from rxfifo[0]
; For write:
;    txfifo[0] = ~0
;    txfifo[0] = (address << 8) | data

; 2 side-set pins + optional bit leaves only 2 delay bits.

.program bus_cycle
.side_set 2 opt
.define e_pin 24

.lang_opt python sideset_init = pico.PIO.OUT_HIGH
.lang_opt python out_init = pico.PIO.OUT_HIGH
.lang_opt python out_shiftdir = 1

loop:
    mov pindirs, null side 0b10 ; all inputs, VMA=0, R/W=1 (idle)
    pull block                  ; read pindirs
    mov x, osr                  ; X has pindirs
    mov y, !x                   ; Y is 0 for writes.
    pull block                  ; OSR has address + data
    wait 1 gpio e_pin           ; wait for E high
    wait 0 gpio e_pin           ; wait for E low (start of cycle)
    jmp !y, do_write

do_read:
    mov pindirs, x side 0b11    ; VMA=1, R/W=1 (read)
    out pins, 32                ; Drive address (data lines are set to inputs)
    wait 1 gpio e_pin           ; wait for E high, VMA=1, R/W=1 (read)
    wait 0 gpio e_pin           ; Wait for E low
    in pins, 8                  ; Sample data
    push noblock           [3]  ; Push to RX FIFO, VMA=0 (+addr hold)
    jmp loop

do_write:
    mov pindirs, x side 0b01    ; VMA=1, R/W=0 (write)
    out pins, 32                ; Drive address, data, VMA=1, R/W=0
    wait 1 gpio e_pin           ; wait for E high (latch)
    wait 0 gpio e_pin      [3]  ; wait for E low (end of cycle), delay for addr hold time
    nop                    [3]

.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "board_config.h"

#define N_ADDR_DATA_PINS 8 + ADDR_LINES

// Initialize bus cycle PIO state machine
static inline void bus_cycle_program_init(PIO pio, uint sm, uint offset) {
    // Initialize GPIO for PIO control (DATA, ADDR, VMA and R/W)
    for (uint i = GPIO_DATA_BASE; i < GPIO_DATA_BASE + N_ADDR_DATA_PINS; i++) {
        pio_gpio_init(pio, i);
    }
    pio_gpio_init(pio, GPIO_VMA);
    pio_gpio_init(pio, GPIO_RW);

    // set DATA as inputs
    pio_sm_set_consecutive_pindirs(pio, sm, GPIO_DATA_BASE, 8, false);
    // set ADDR as outputs
    pio_sm_set_consecutive_pindirs(pio, sm, GPIO_ADDR_BASE, ADDR_LINES, true);
    // Set VMA and R/W as outputs
    pio_sm_set_pindirs_with_mask(pio, sm,
        (1u << GPIO_VMA) | (1u << GPIO_RW),     // dirs
        (1u << GPIO_VMA) | (1u << GPIO_RW));    // mask
    pio_sm_set_pins_with_mask(pio, sm, 
        (0u << GPIO_VMA) | (1u << GPIO_RW),     // init
        (1u << GPIO_VMA) | (1u << GPIO_RW));    // mask

    // Get default configuration
    pio_sm_config c = bus_cycle_program_get_default_config(offset);

    // Configure OUT pins: GPIO 0-7 (data bus), GPIO 8-23 (address bus)
    sm_config_set_out_shift(&c, false, false, N_ADDR_DATA_PINS);
    sm_config_set_out_pins(&c, GPIO_DATA_BASE, N_ADDR_DATA_PINS);

    // Configure IN pins: GPIO 0-7 (data bus)
    sm_config_set_in_pins(&c, GPIO_DATA_BASE);
    sm_config_set_in_shift(&c, false, false, 8);  // Shift left, no autopush, 8 bits

    // Configure SIDE-SET: GPIO 25-26 (VMA + R/W, 2 bits consecutive)
    // optional side-set uses another of the 5 bits, leaving only 2 for delay
    sm_config_set_sideset_pins(&c, GPIO_VMA);
    sm_config_set_sideset(&c, 2, true, false);  // 2 bits, optional, not pindirs

    // Use full system clock speed (no divider) for finest timing control
    // At 266 MHz: 1 cycle = 3.759ns
    sm_config_set_clkdiv(&c, 1.0f);

    // Initialize and enable state machine
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}