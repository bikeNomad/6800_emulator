; PIO programs for MC6800 bus cycle timing
; Provides precise hardware-timed bus read/write operations
;
; Pin Configuration (NED_SYS7):
;   GPIO 0-7:   Data bus (IN pins)
;   GPIO 24:    E clock (WAIT source, controlled by SM0)
;   GPIO 25-26: VMA + R/W (SIDE-SET, 2 bits consecutive)
;
; Clock: Full system clock (no divider) for finest timing resolution
; Data setup/hold delay: Dynamically calculated based on SYS_CLOCK_MHZ
; Target delay: 300ns (exceeds MC6821 PIA 290ns requirement with margin)

.program bus_read_cycle

.side_set 2         ; GPIO 25=VMA, GPIO 26=R/W (2 bits consecutive)

; Entry point for read cycle
; Software must set up address bus and data direction before triggering
; Returns: 8-bit data in RX FIFO
public read_cycle:
    wait 0 gpio 24      side 0b10       ; Sync: Wait for E low, VMA=0, R/W=1 (idle)
    wait 1 gpio 24      side 0b11       ; Assert VMA=1, R/W=1 (read mode), Wait for E high
    ; Data setup delay:
    ; Target: 300ns for MC6821 PIA worst-case data delay (290ns + margin)
    ; TODO: Actual delay calculated at runtime based on SYS_CLOCK_MHZ
    ; Default: 81 cycles = 304.5ns @ 266MHz
public set_loop_count:
    set x, 9            side 0b11       ; Initialize loop counter (1 cycle)
read_delay:
    jmp x-- read_delay [7] side 0b11   ; Loop 10 times x 8 cycles = 80 cycles
    in pins, 8          side 0b11       ; Sample data (now stable!), keep signals
    wait 0 gpio 24      side 0b11       ; Wait for E low, keep signals
    push noblock        side 0b10       ; Push to RX FIFO, VMA=0


.program bus_write_cycle

; Set pins: GPIO 25=VMA, GPIO 26=R/W

; Entry point for write cycle
; Software must set up address bus and data direction before triggering
; Write is triggered by pushing data to TX FIFO
; Note: Write cycles only need to wait for E clock edges - no delay loop needed
; The peripheral latches data on E rising edge, then cycle ends on E falling edge
public write_cycle:
    pull block          ; Pull data from TX FIFO (blocks if empty)
    set pins, 0b10      ; Deassert VMA=0, R/W=1 (idle)
    wait 0 gpio 24      ; Wait for E low, idle
    out pins, 8         ; Drive data bus
    set pins, 0b01      ; Assert VMA=1, R/W=0 (write)
    mov pindirs, !null  ; set as outputs
    wait 1 gpio 24      ; Wait for E high (latch)
    wait 0 gpio 24      ; Wait for E low (end of cycle)
    mov pindirs, null   ; set as inputs
    set pins, 0b10      ; Deassert VMA=0, R/W=1 (idle)
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "board_config.h"

// Calculate delay cycles needed for 300ns data setup/hold time
// Returns the number of PIO cycles needed to achieve ~300ns delay
// at the current system clock frequency
static inline uint32_t calculate_bus_delay_cycles(void) {
    uint32_t sys_clock_hz = clock_get_hz(clk_sys);

    // Target delay: 300ns (exceeds MC6821 PIA 290ns requirement with margin)
    // Convert to cycles: (300ns * sys_clock_hz) / 1000000000
    uint64_t cycles = ((uint64_t)300 * sys_clock_hz) / 1000000000;

    // Ensure minimum delay of 1 cycle
    if (cycles < 1) {
        cycles = 1;
    }

    return (uint32_t)cycles;
}

// Initialize bus read cycle PIO state machine
static inline void bus_read_cycle_program_init(PIO pio, uint sm, uint offset) {
    // Get default configuration
    pio_sm_config c = bus_read_cycle_program_get_default_config(offset);

    // Configure IN pins: GPIO 0-7 (data bus)
    sm_config_set_in_pins(&c, GPIO_DATA_BASE);
    sm_config_set_in_shift(&c, false, false, 8);  // Shift left, no autopush, 8 bits

    // Configure SIDE-SET: GPIO 25-26 (VMA + R/W, 2 bits consecutive)
    sm_config_set_sideset_pins(&c, GPIO_VMA);
    sm_config_set_sideset(&c, 2, false, false);  // 2 bits, not optional, no pindirs

    // Use full system clock speed (no divider) for finest timing control
    // At 266 MHz: 1 cycle = 3.759ns
    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_set_pins_with_mask(pio, sm, 0, (0u << GPIO_VMA) | (1u << GPIO_RW));

    // Set VMA and R/W as outputs
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << GPIO_VMA) | (1u << GPIO_RW), (1u << GPIO_VMA) | (1u << GPIO_RW));

    // Initialize GPIO for PIO control (VMA and R/W)
    pio_gpio_init(pio, GPIO_VMA);
    pio_gpio_init(pio, GPIO_RW);

    // Initialize state machine (will be enabled later to trigger)
    pio_sm_init(pio, sm, offset, &c);
}

// Initialize bus write cycle PIO state machine
static inline void bus_write_cycle_program_init(PIO pio, uint sm, uint offset) {
    // Get default configuration
    pio_sm_config c = bus_write_cycle_program_get_default_config(offset);

    // Configure SET: GPIO 25-26 (VMA + R/W, 2 bits consecutive)
    sm_config_set_set_pins(&c, GPIO_VMA, 2);

    // Use full system clock speed (no divider)
    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_set_pins_with_mask(pio, sm, 0, (0u << GPIO_VMA) | (1u << GPIO_RW));

    // Set VMA and R/W as outputs
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << GPIO_VMA) | (1u << GPIO_RW), (1u << GPIO_VMA) | (1u << GPIO_RW));

    // Initialize GPIO for PIO control (VMA and R/W)
    pio_gpio_init(pio, GPIO_VMA);
    pio_gpio_init(pio, GPIO_RW);

    // Initialize state machine
    pio_sm_init(pio, sm, offset, &c);

    pio_sm_set_enabled(pio, sm, true);
}
%}
