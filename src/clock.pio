; PIO program to generate E clock for MC6800 emulator
; Target frequency: 3.579545 MHz / 4 = 0.894886 MHz
; Period: 1.117µs (approximately 560ns high, 560ns low)
; Single OUT pin is E clock

.program eclock

.fifo txput             ; Enable rxf_putget registers for direct FIFO access

entry_point:
    mov x, ~null        ; Initialize X to 0xFFFFFFFF (count down)
    mov isr, x          ; Move X to ISR (1 cycle)
    mov rxfifo[0], isr  ; Write ISR directly to rxfifo[0] (1 cycle)

.wrap_target
loop:
    set pins, 1 [30]    ; E clock high, delay 31 cycles
    mov isr, x          ; Move X to ISR (1 cycle)
    set pins, 0 [30]    ; E clock low, delay 31 cycles
    mov rxfifo[0], isr  ; Write ISR directly to rxfifo[0] (1 cycle)
    jmp x-- loop        ; Decrement X each cycle and loop
.wrap


; Program to wait a given number of E clock cycles
; (falling edges)
; single IN pin is E clock
; single OUT pin is TEST pin for debugging
; Usage: push (number-1) to txfifo[0]
;        get from rxfifo[0] when done

.program sync

.wrap_target
entry_point:
    set pins, 0         ; test pin low
    pull block          ; get count
    set pins, 1         ; test pin high
    mov x, osr          ; X has count
next_edge:
    wait 1 pin 0        ; wait for E clock HIGH
    wait 0 pin 0        ; wait for E clock LOW
    jmp x--, next_edge  ; another edge if X>0

    push                ; signal done
.wrap


; Program to count external E clock cycles (falling edges)
; IN pin is external E clock input (GPIO_ECLOCK_IN)
; SET pin is E clock output (GPIO_ECLOCK) - mirrors input for bus_cycle PIO
; Provides cycle count via rxfifo[0] (same interface as eclock program)

.program eclock_external

.fifo txput             ; Enable rxf_putget registers for direct FIFO access

entry_point:
    mov x, ~null        ; Initialize X to 0xFFFFFFFF (count down)
    mov isr, x          ; Move X to ISR
    mov rxfifo[0], isr  ; Initialize counter in rxfifo[0]

.wrap_target
    wait 1 pin 0        ; Wait for E clock input HIGH
    set pins, 1         ; Mirror HIGH to output
    wait 0 pin 0        ; Wait for E clock input LOW (falling edge)
    set pins, 0         ; Mirror LOW to output
    jmp x-- continue    ; Decrement X
continue:
    mov isr, x          ; Move X to ISR
    mov rxfifo[0], isr  ; Update cycle count
.wrap


% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"
#include "hardware/irq.h"
#include "hardware/structs/scb.h"

static inline void eclock_program_init(PIO pio, uint sm, uint offset, uint pin) {
    // Configure pin as PIO output
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    // Get default configuration
    pio_sm_config c = eclock_program_get_default_config(offset);

    // Configure SET pins
    sm_config_set_set_pins(&c, pin, 1);

    // Configure clock divider dynamically based on system clock
    // Target E clock: 3.579545 MHz / 4 = 0.894886 MHz
    // PIO cycles per E cycle: 65 (32 high + 32 low + 1 jmp)
    // Required PIO clock: 0.894886 MHz * 65 = 58.17 MHz
    // Divider = System clock / PIO clock
    uint32_t sys_clock = clock_get_hz(clk_sys);
    float divider = (float)sys_clock / 58170000.0f;

    // Extract integer and fractional parts
    uint16_t div_int = (uint16_t)divider;
    uint8_t div_frac = (uint8_t)((divider - div_int) * 256.0f);

    sm_config_set_clkdiv_int_frac(&c, div_int, div_frac);

    // Initialize state machine
    pio_sm_init(pio, sm, offset, &c);
    // Stop immediately (will be started later)
    pio_sm_set_enabled(pio, sm, false);
}

// ISR for PIO0_IRQ_0.  The IRQ source (SYNC_SM RX-FIFO not-empty) is
// level-triggered: it stays asserted until the FIFO is drained.  A handler
// that simply returns causes the NVIC to tail-chain back into itself
// indefinitely, starving the main thread.  Disabling the IRQ here breaks the
// loop; eclock_wait_cycles() re-arms it right before each __wfe().
static void pio0_irq0_handler(void) {
    irq_set_enabled(PIO0_IRQ_0, false);
}

static inline void sync_program_init(PIO pio, uint sm, uint offset, uint clock_pin, uint test_pin) {
    pio_gpio_init(pio, test_pin); 

    // Configure test pin as PIO output
    pio_sm_set_consecutive_pindirs(pio, sm, test_pin, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 0, 1 << test_pin);

    pio_sm_config c = sync_program_get_default_config(offset);
    sm_config_set_set_pins(&c, test_pin, 1);
    sm_config_set_in_pins(&c, clock_pin);
    
    sm_config_set_clkdiv_int_frac(&c, 1, 0);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);

    // Setup for using WFE during wait for sync:
    // 1. Allow "Pending" interrupts to wake the CPU from WFE
    scb_hw->scr |= M33_SCR_SEVONPEND_BITS;

    // 2. Use the SM's RX FIFO not-empty signal as the IRQ source.
    //    This naturally asserts on push and deasserts on get, giving a
    //    clean Not-Pending→Pending edge every cycle without needing to
    //    clear any flags.
    pio_set_irq0_source_enabled(pio, (enum pio_interrupt_source)(pis_sm0_rx_fifo_not_empty + sm), true);

    // 3. Register the handler but leave the IRQ disabled.
    //    eclock_wait_cycles() arms it immediately before each __wfe() and
    //    the ISR disables it again on entry, so exactly one exception fires
    //    per sync-SM push.
    irq_set_exclusive_handler(PIO0_IRQ_0, pio0_irq0_handler);
    irq_set_enabled(PIO0_IRQ_0, false);
}

static inline void eclock_external_program_init(PIO pio, uint sm, uint offset, uint out_pin, uint in_pin) {
    // Configure output pin (GPIO_ECLOCK) as PIO output - mirrors external clock
    // so bus_cycle PIO can still synchronize to it
    pio_gpio_init(pio, out_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, out_pin, 1, true);  // true = output

    // Configure input pin (GPIO_ECLOCK_IN) for reading external clock
    gpio_init(in_pin);
    gpio_set_dir(in_pin, GPIO_IN);
    gpio_set_input_enabled(in_pin, true);

    // Get default configuration
    pio_sm_config c = eclock_external_program_get_default_config(offset);

    // Configure SET pin for clock output (mirrors external clock)
    sm_config_set_set_pins(&c, out_pin, 1);

    // Configure IN pin for wait instructions - use the dedicated input pin
    sm_config_set_in_pins(&c, in_pin);

    // Run at full system clock speed to catch all edges
    sm_config_set_clkdiv_int_frac(&c, 1, 0);

    // Initialize state machine
    pio_sm_init(pio, sm, offset, &c);
    // Stop immediately (will be started later)
    pio_sm_set_enabled(pio, sm, false);
}

%}
